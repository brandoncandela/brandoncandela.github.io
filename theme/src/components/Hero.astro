---
import Scene3D from './Scene3D';
---
<header class="apple-hero" id="top">
 <div class="hero-scene" aria-hidden="true"><Scene3D client:idle /></div>
 <div class="hero-content">
  <img class="hero-portrait" src="/assets/brandon-portrait-square.jpg" width="144" height="144" alt="Portrait of Brandon Candela" fetchpriority="high" />
  <h1>Brandon Candela</h1>
  <p class="hero-title">Building intelligent financial crime technology.</p>
  <p class="hero-pillars">AI-assisted investigations <span aria-hidden="true">·</span> Blockchain intelligence <span aria-hidden="true">·</span> Fintech risk infrastructure</p>
  <p class="hero-cred">CAMS · PMP · 6 years at TD Bank, KPMG, IBM, Deutsche Bank</p>
  <div class="actions"><a class="button" href="#projects">See flagship builds</a><a class="button ghost" href="/case-studies/">Read case studies</a><a class="button ghost" href="#contact">Contact</a></div>
  <span class="status">Open to compliance tech, solutions and implementation roles · Remote or New York</span>
 </div>
</header>
