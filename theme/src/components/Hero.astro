---
import Scene3D from './Scene3D';
---
<header class="apple-hero" id="top">
 <div class="hero-scene" aria-hidden="true"><Scene3D client:idle /></div>
 <div class="hero-content">
  <img class="hero-portrait" src="/assets/brandon-portrait-square.jpg" width="144" height="144" alt="Portrait of Brandon Candela" fetchpriority="high" />
  <h1>Brandon Candela</h1>
  <p class="hero-title">AML investigations. Controls. Data.</p>
  <p class="hero-tagline">Follow the evidence. Explain the decision.</p>
  <div class="actions"><a class="button" href="#projects">View selected work</a><a class="button ghost" href="#contact">Get in touch</a></div>
  <span class="status">Open to AML &amp; financial crime roles · Remote or New York</span>
 </div>
</header>
